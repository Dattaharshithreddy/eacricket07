<?xml version="1.0" encoding="utf-8"?>
<!-- A plain launcher icon: a red ball on a green pitch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1F7A3F" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:left="30dp" android:top="30dp" android:right="30dp" android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="#D23A2F" />
            <stroke android:width="3dp" android:color="#F4E9D8" android:dashWidth="4dp" android:dashGap="3dp" />
        </shape>
    </item>
</layer-list>
